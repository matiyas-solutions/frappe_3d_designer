 "html": "<style>\n@page { size: A4 landscape; margin: 8mm; }\n.f3d-drawing table { width: 100%; font-size: 10px; border-collapse: collapse; margin-top: 10px; page-break-before: always; }\n.f3d-drawing th, .f3d-drawing td { border-bottom: 1px solid #d5dbd8; padding: 3px 4px; text-align: left; }\n</style>\n<div class=\"f3d-drawing\">\n  {{ design_technical_drawing(doc.name) | safe }}\n  <table>\n    <tr><th>#</th><th>{{ _(\"Part\") }}</th><th>{{ _(\"Material / Item\") }}</th><th>{{ _(\"L × W × T\") }}</th><th>{{ _(\"Qty\") }}</th><th>{{ _(\"Edges L/S\") }}</th></tr>\n    {% for p in doc.parts %}\n    <tr><td>{{ p.idx }}</td><td>{{ p.part_name }}</td><td>{{ p.material or p.item_code or p.source_material or \"\" }}</td>\n      <td>{{ p.length_mm }} × {{ p.width_mm }} × {{ p.thickness_mm }}</td><td>{{ p.qty }}</td><td>{{ p.edge_band_long }}/{{ p.edge_band_short }}</td></tr>\n    {% endfor %}\n  </table>\n</div>",
